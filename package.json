{
  "name": "aphelion5",
  "version": "0.1.0",
  "private": true,
  "description": "Aphelion 5 - solo campaign board game, computer version",
  "type": "module",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "play": "tsx scripts/play.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:ui": "vite build && node scripts/ui-check.mjs",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
